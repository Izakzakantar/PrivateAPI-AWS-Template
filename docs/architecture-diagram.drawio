        </mxCell>
        <mxCell id="svc-dynamodb" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fontFamily=Helvetica;shadow=1;" value="DynamoDB&lt;div&gt;&lt;i&gt;on-demand&lt;/i&gt;&lt;/div&gt;" vertex="1" parent="svc-group-dynamodb">
          <mxGeometry x="36" y="30" width="48" height="48" as="geometry" />
        </mxCell>

        <!-- ===================== EDGES ===================== -->

        <!-- e1: Client -> Route 53 -->
        <mxCell id="edge-1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;elbow=vertical;startArrow=none;endFill=1;strokeColor=#545B64;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="users-icon" target="svc-route53">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-1-label" value="1. Resolve domain (optional)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=none;fontSize=11;fontFamily=Helvetica;" connectable="0" vertex="1" parent="edge-1">
          <mxGeometry relative="1" x="0" y="-1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- e2: Client -> CloudFront (routed above Route 53) -->
        <mxCell id="edge-2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;elbow=vertical;startArrow=none;endFill=1;strokeColor=#545B64;rounded=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="users-icon" target="svc-cloudfront">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="110" y="110" />
              <mxPoint x="670" y="110" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-2-label" value="2. HTTPS request" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=none;fontSize=11;fontFamily=Helvetica;" connectable="0" vertex="1" parent="edge-2">
          <mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- e3: CloudFront -> WAF (attached) -->
        <mxCell id="edge-3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;elbow=vertical;startArrow=none;endFill=1;strokeColor=#545B64;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="svc-cloudfront" target="svc-waf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-3-label" value="3. WAF inspects the request" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=none;fontSize=11;fontFamily=Helvetica;" connectable="0" vertex="1" parent="edge-3">
          <mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- e4: CloudFront -> Internal ALB (VPC Origin) -->
        <mxCell id="edge-4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;elbow=vertical;startArrow=none;endFill=1;strokeColor=#545B64;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="svc-cloudfront" target="svc-alb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-4-label" value="4. VPC Origin forwards to the ALB" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=none;fontSize=11;fontFamily=Helvetica;" connectable="0" vertex="1" parent="edge-4">
          <mxGeometry relative="1" x="0" y="-1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- e5: ALB -> VPC Endpoint -->
        <mxCell id="edge-5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;elbow=vertical;startArrow=none;endFill=1;strokeColor=#545B64;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="svc-alb" target="svc-vpce">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-5-label" value="5. Forwards to the endpoint's IP targets" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=none;fontSize=11;fontFamily=Helvetica;" connectable="0" vertex="1" parent="edge-5">
          <mxGeometry relative="1" x="0" y="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- e6: VPC Endpoint -> API Gateway (PrivateLink) -->
        <mxCell id="edge-6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;elbow=vertical;startArrow=none;endFill=1;strokeColor=#545B64;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="svc-vpce" target="svc-apigw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-6-label" value="6. Delivered over PrivateLink" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=none;fontSize=11;fontFamily=Helvetica;" connectable="0" vertex="1" parent="edge-6">
          <mxGeometry relative="1" x="0" y="-1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- e7: API Gateway -> Cognito (JWT authorizer) -->
        <mxCell id="edge-7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;elbow=vertical;startArrow=none;endFill=1;strokeColor=#545B64;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="svc-apigw" target="svc-cognito">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-7-label" value="7. Validate JWT before Lambda" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=none;fontSize=11;fontFamily=Helvetica;" connectable="0" vertex="1" parent="edge-7">
          <mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- e8: API Gateway -> Lambda -->
        <mxCell id="edge-8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;elbow=vertical;startArrow=none;endFill=1;strokeColor=#545B64;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="svc-apigw" target="svc-lambda">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-8-label" value="8. Invoke Lambda" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=none;fontSize=11;fontFamily=Helvetica;" connectable="0" vertex="1" parent="edge-8">
          <mxGeometry relative="1" x="0" y="-1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- e9: Lambda -> DynamoDB -->
